{
  "expo": {
    "name": "InstaClone",
    "slug": "instaclone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.anonymous.instaclone"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
